# ── App ────────────────────────────────────────────────────────────────────────
SECRET_KEY=replace-with-a-long-random-string
DEBUG=false

# ── Database (PostgreSQL) ──────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://cesucar_user:cesucar_pass@localhost:5432/cesucar_db

# Used by Alembic (must match DATABASE_URL)
ALEMBIC_DATABASE_URL=postgresql://cesucar_user:cesucar_pass@localhost:5432/cesucar_db

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=replace-with-another-long-random-string
JWT_EXPIRES_HOURS=24

# ── Admin account ──────────────────────────────────────────────────────────────
# RGM is always: 00000001
# Set a STRONG password here (minimum 8 characters)
ADMIN_PASSWORD=

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000
