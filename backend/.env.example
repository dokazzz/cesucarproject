# Copy this file to backend/.env and fill it in. backend/.env is gitignored
# and must never be committed.
#
# SECRET_KEY, JWT_SECRET_KEY and DATABASE_URL are mandatory: the application
# refuses to start without them rather than falling back to a default. Generate
# a secret with:
#
#     python -c "import secrets; print(secrets.token_urlsafe(48))"

# ── App ────────────────────────────────────────────────────────────────────────
# Required. Minimum 32 characters unless DEBUG=true.
SECRET_KEY=
DEBUG=false

# ── Database (PostgreSQL) ──────────────────────────────────────────────────────
# Required, no fallback. Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=

# Used by Alembic (must match DATABASE_URL)
ALEMBIC_DATABASE_URL=

# ── JWT ────────────────────────────────────────────────────────────────────────
# Required. Minimum 32 characters unless DEBUG=true. Anyone holding this value
# can mint a token for any account, including the administrator.
JWT_SECRET_KEY=
JWT_EXPIRES_HOURS=24

# ── Admin account ──────────────────────────────────────────────────────────────
# RGM is always 00000001. Minimum 8 characters. Without it the admin account is
# not created at startup and a warning is logged.
ADMIN_PASSWORD=

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# ── Rate limiting ──────────────────────────────────────────────────────────────
# Applied per client IP to the login and register endpoints.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=8/minute
RATE_LIMIT_REGISTER=12/hour

# Set to true ONLY when a reverse proxy you control (Caddy, nginx) sits in
# front and sets X-Forwarded-For. Wrong either way is a real failure:
#   false behind a proxy -> every request looks like the proxy's IP, so all
#                           users share one bucket and one attacker locks
#                           everybody out.
#   true when exposed     -> a client can spoof the header and never be limited.
TRUST_PROXY_HEADERS=false

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# true emits one JSON object per line, for Promtail/Loki. Leave false locally.
LOG_JSON=false
